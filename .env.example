# =============================================================================
# Git-To-Go — Docker Compose Environment Variables
# Copy to .env and fill real values: cp .env.example .env
# NEVER commit .env to git!
# =============================================================================

# ==================== PostgreSQL ====================
POSTGRES_DB=deploydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-db-password
POSTGRES_PORT=5432

# ==================== Spring Boot ====================
SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=update

# ==================== JWT ====================
# Generate: openssl rand -base64 64
JWT_SECRET=your-base64-encoded-jwt-secret
JWT_EXPIRATION=86400000

# ==================== OAuth2 — GitHub ====================
# Create at: https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=your-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret

# ==================== OAuth2 — Google ====================
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# ==================== Email (SMTP) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_ENABLED=true

# ==================== Encryption ====================
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# ==================== Server URLs ====================
# Replace with your domain or server IP for production
SERVER_URL=http://localhost
OAUTH2_REDIRECT_URI=http://localhost/oauth2/callback
CORS_ORIGINS=http://localhost
DEPLOYMENT_BASE_URL=http://localhost
EMAIL_VERIFICATION_URL=http://localhost/api/auth/verify-email

# ==================== Grafana ====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password
