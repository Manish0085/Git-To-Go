# =============================================================================
# Git-To-Go Backend — Environment Variables
# Copy to .env and fill real values: cp .env.example .env
# NEVER commit .env to git!
# =============================================================================

# ==================== DATABASE ====================
DB_URL=jdbc:postgresql://localhost:5432/deploydb
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# ==================== JWT ====================
# Generate: openssl rand -base64 64
JWT_SECRET=your-base64-encoded-jwt-secret-min-32-bytes
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ==================== OAUTH2 — GOOGLE ====================
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==================== OAUTH2 — GITHUB ====================
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ==================== EMAIL (SMTP) ====================
# Gmail: Enable 2FA → App Passwords → Generate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_ENABLED=true

# ==================== ENCRYPTION ====================
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# ==================== APP URLs ====================
# Change these when deploying to server (use your domain/IP)
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback
DEPLOYMENT_BASE_URL=http://localhost
EMAIL_VERIFICATION_URL=http://localhost:8080/api/auth/verify-email
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WEBHOOK_BASE_URL=http://localhost:8080

# ==================== BUILD & LOGS ====================
BUILDS_DIR=/tmp/git2go/builds
LOGS_DIR=/tmp/git2go/logs
LOGS_RETENTION_DAYS=7

# ==================== SERVER ====================
SERVER_PORT=8080
JPA_DDL_AUTO=update
SHOW_SQL=false
